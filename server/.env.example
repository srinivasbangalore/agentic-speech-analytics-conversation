# Paths are relative to the repository root. These files are downloaded once by
# server\download_models.py and then loaded from disk with offline mode enabled.
ASR_MODEL_PATH=models/speech-analytics/faster-whisper-small
EMOTION_MODEL_PATH=models/speech-analytics/emotion-english-distilroberta-base

# llama.cpp must bind to loopback. The app rejects non-loopback LLM endpoints.
LLM_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
LLM_MODEL=muse-glimmer
LLM_TIMEOUT_SECONDS=240
